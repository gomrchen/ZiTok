{
  "title": "VideoHub 监控总览",
  "panels": [
    {
      "title": "请求流量",
      "type": "stat",
      "targets": [{"expr": "rate(videohub_http_requests_total[5m])"}],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "title": "错误率",
      "type": "stat", 
      "targets": [{"expr": "rate(videohub_http_requests_total{status=~\"5..\"}[5m]) / rate(videohub_http_requests_total[5m]) * 100"}],
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
    },
    {
      "title": "响应时间",
      "type": "stat",
      "targets": [{"expr": "histogram_quantile(0.95, rate(videohub_http_request_duration_seconds_bucket[5m])) * 1000"}],
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "title": "Goroutines",
      "type": "stat",
      "targets": [{"expr": "go_goroutines"}],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "5s"
}
